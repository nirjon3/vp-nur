{
  "name": "nurul-haque-nur-website",
  "version": "1.0.0",
  "private": true,
  "description": "Official personal website of Nurul Haque Nur (VP Nur) — Bengali-first, editorial institutional design.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "node --experimental-strip-types scripts/seed.mts",
    "cms:types": "node --experimental-strip-types node_modules/payload/bin.js generate:types --disable-transpile",
    "cms:importmap": "node --experimental-strip-types node_modules/payload/bin.js generate:importmap --disable-transpile",
    "cms:migrate": "node --experimental-strip-types node_modules/payload/bin.js migrate --disable-transpile",
    "cms:migrate:create": "node --experimental-strip-types node_modules/payload/bin.js migrate:create --disable-transpile"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@payloadcms/db-postgres": "^3.93.0",
    "@payloadcms/db-sqlite": "^3.93.0",
    "@payloadcms/next": "^3.93.0",
    "@payloadcms/richtext-lexical": "^3.93.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "graphql": "^16.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "payload": "^3.93.0",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.65.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.5",
    "typescript": "^5"
