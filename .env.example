# --- Site ---
# Public base URL of the deployed site (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://nurulhaquenur.com.bd

# --- Payload CMS ---
# Generate a long random string for production (e.g. `openssl rand -base64 48`).
# In production the app refuses to boot without it.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Local dev uses SQLite by default: file:./payload.db
# For production, switch @payloadcms/db-sqlite to @payloadcms/db-postgres
# and set a PostgreSQL connection string, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/nur_website
DATABASE_URL=file:./payload.db

# --- Seeding ---
# Used only by `npm run seed` to create the first Super Admin.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-minimum-12-characters
